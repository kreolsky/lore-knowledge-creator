# Copy to .env and fill in all values. Every REQUIRED var MUST be set (no default).
# Commented vars are OPTIONAL and ship a sane dev default; uncomment to override.

# ─── SurrealDB ───────────────────────────────────────────────────────────────
# Nothing to set: the address, user, namespace and database are compose wiring
# (backend/config.py constants), and the password is generated by secrets-init
# into the `secrets` volume on every `up` — there is no env leg for any of
# them.

# ─── Backend ─────────────────────────────────────────────────────────────────
# REQUIRED on first boot: creates the admin user ONLY while the instance has no
# live admin (also the recovery path if every admin was deleted). Never re-creates
# a deleted admin while another admin exists.
LORE_ADMIN_USERNAME=
LORE_ADMIN_PASSWORD=
# Comma-separated allowed CORS origins. Defaults to localhost dev origins if unset.
# The http://frontend:5173 entry is the COMPOSE-NETWORK origin the e2e Playwright
# browser really sends (E2E_BASE_URL=http://frontend:5173) — without it the CSRF
# Origin guard 403s every mutating request from the browser (POST /api/documents,
# prefs PUTs) and every UI-driven e2e mutation silently fails.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://frontend:5173

# ─── Redis / job queue ──────────────────────────────────────────────────────
STT_CONCURRENCY=2
# Pub/sub publish deadline (s). Hangs on a wedged connection are converted to the
# already-handled TimeoutError path; raise only if your Redis has high latency.
# BACKPLANE_PUBLISH_TIMEOUT_S=5

# ─── Storage limits ──────────────────────────────────────────────────────────
MAX_AUDIO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=50
MAX_MARKDOWN_SIZE_MB=50
MAX_DOCX_SIZE_MB=25
# PDF imports (pymupdf4llm via the converter). Own cap, not shared with docx.
MAX_PDF_SIZE_MB=50
# Agent-shared .zip archives (import_file sandbox_path; the widget stays zip-free)
MAX_ARCHIVE_SIZE_MB=100

# ─── Model-bound image normalization ─────────────────────────────────────────
# Images are downscaled + re-encoded before reaching the model. WebP is NEVER
# sent (silently dropped by the local Qwen models). Re-measure the cap when the
# model behind the endpoint changes (see backend/config.py).
MODEL_IMAGE_MAX_PIXELS=1250000
MODEL_IMAGE_JPEG_QUALITY=85
# Which models accept images is NOT configured — the gateway reports it per model
# and the harness resolves it.

# ─── AI API (base URL/key, shared by STT + Chat) ───────────────────────────
AI_API_URL=
AI_API_KEY=

# ─── Speech-to-Text (overrides AI_API_* if set) ────────────────────────────
# STT_API_URL=
# STT_API_KEY=
STT_MODEL=whisper-1

# ─── Chat / LLM ─────────────────────────────────────────────────────────────
CHAT_MODEL=local/orange/chat
# The model the harness titler names sessions with (admin-editable; served to
# the harness at its start). Falls back to CHAT_MODEL if not set.
# CHAT_TITLE_MODEL=

# ─── Agent turn ──────────────────────────────────────────────────────────────
# Per-session turn lock TTL (s) — guards one active turn per chat_session. Kept
# SHORT (fast self-heal on a leaked lock); the heartbeat
# (TURN_LOCK_HEARTBEAT_S) keeps a legitimately slow/held turn's lock alive,
# so the TTL does not need to sit above the turn timeout.
# TURN_LOCK_TTL_S=30
# No-progress budget for one agent turn (s), progress-extended: armed at turn
# start and re-armed by every real driver frame, so a turn that is demonstrably
# working is never killed by the wall clock — only a silent one dies (one grace
# window after its last frame).
# TURN_PROGRESS_GRACE_S=300.0
# Hard ceiling (s) from turn start: past it the breach fires whatever the
# driver is doing — even steady progress cannot outlive the wall. Approval
# holds are excluded; worst-case wall = this + the hold cap (600).
# TURN_MAX_WALL_S=1800.0
# The bound (s) on ONE mid-turn approval ask before the driver self-resolves it
# rejected (LORE_APPROVAL_MAX_S in the harness service). Keep it at or below the
# aggregate hold pause above, or the turn deadline fires while the user still
# has a live approval card on screen.
# HARNESS_APPROVAL_MAX_S=600
# Loop guards are harness-side: dsh's repeat-tool-reminder and the read-proxy
# timeout budget; TURN_MAX_WALL_S above is the hard bound.
# Fraction of the document above which an edit is rejected as a full rewrite.
# AGENT_FULL_REWRITE_FRACTION=0.9
# Direct (non-semantic) title/substring match layer count for search_materials.
# AGENT_SEARCH_DIRECT_K=5

# ─── Query rewrite ────────────────────────────────────────────────────────────
# CHAT_QUERY_REWRITE_ENABLED=true
# CHAT_QUERY_REWRITE_MODEL=
# CHAT_QUERY_REWRITE_HISTORY_MESSAGES=6
# CHAT_QUERY_REWRITE_SNIPPET_CHARS=200
# CHAT_QUERY_REWRITE_TIMEOUT_S=15

# ─── Retrieval (RAG search quality/quantity tradeoff) ───────────────────────
# Minimum cosine similarity to include a hit. Calibrated per EMBEDDING_MODEL
# (0.18 for embeddings/giga/480m; qwen3/600m needed 0.35) — see backend/config.py.
# RETRIEVAL_MIN_SCORE=0.18
# Ratio threshold: hits[i].score < hits[i-1].score * this → cutoff.
# RETRIEVAL_SCORE_DROP_OFF=0.65
# Cosine at/above which a new memory fact is refused as a duplicate. Calibrated per
# EMBEDDING_MODEL (0.82 for embeddings/giga/480m; qwen3/600m needed 0.89).
# MEMORY_DUPLICATE_FACT_THRESHOLD=0.82

# ─── Embeddings (OpenAI-compatible, optional — lazy validation at first use) ─
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# Changing the model obliges re-calibrating RETRIEVAL_MIN_SCORE and
# MEMORY_DUPLICATE_FACT_THRESHOLD (see backend/config.py).
# EMBEDDING_MODEL=embeddings/giga/480m
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_CONCURRENCY=4
# EMBEDDING_COOLDOWN_SEC=3600

# ─── History thinning (GFS / last-session retention) ────────────────────────
# THIN_RECENT_HOURS=48
# THIN_DAILY_KEEP_DAYS=30
# THIN_WEEKLY_KEEP_WEEKS=12
# UTC hour at which the daily thinning cron runs.
# THIN_CRON_HOUR=3

# ─── Schema guard ────────────────────────────────────────────────────────────
# Boot-time schema-fingerprint guard severity. Default true: recorded fields
# missing from the live schema with no migration run REFUSES startup (the
# stale-schema-restore incident class — data-loss-grade). Set to false ONLY to
# boot a wedged environment for repair; the mismatch still logs LOUD.
# SCHEMA_FINGERPRINT_FATAL=true

# ─── MCP gateway (external agent surface) ───────────────────────────────────
# run_extractor is a ~50s dev/benchmark tool dry-running the local LLM. It is
# OFF the default MCP surface (advertising it to every external client is a
# footgun). Set to 1 to advertise it (the CIR benchmark path).
# MCP_RUN_EXTRACTOR=0
# TTL (seconds) on the signed download URL minted by the download_reference_file
# tool. The token authorizes exactly one ref_id and expires; short by design.
# MCP_DOWNLOAD_TOKEN_TTL_S=300
# TTL (seconds) on the signed UPLOAD URL minted by upload_reference_file. Covers
# the client's whole stream (large audio), so longer than the download TTL.
# MCP_UPLOAD_TOKEN_TTL_S=900

# ─── Agent sandbox (SYSTEM: agent-sandbox) ──────────────────────────────────
# The agent's console host — an SSH box with Python. Dev: the `sandbox` compose
# service. Prod: a separate SSH host running the same image policy.
# Unset SANDBOX_SSH_HOST (or the key) = the sandbox_bash tool is simply not served.
# That is a valid deploy, not an error — every other chat feature still works.
SANDBOX_SSH_HOST=sandbox
# SANDBOX_SSH_PORT=22
# SANDBOX_SSH_USER=agent
# The PRIVATE key, base64 (`base64 -w0 sandbox_key`). Base64 because a PEM's
# newlines do not survive .env parsing.
# INVARIANT(security): this NEVER goes in the repo or the image — only the PUBLIC
# half is committed (sandbox/authorized_keys). Generate a pair per environment; see
# the rotation section of docs/sandbox-access.md.
SANDBOX_SSH_KEY_B64=

# Extra egress denies for the sandbox netns (applied by the sandbox-gw sidecar),
# comma-separated CIDRs (v4 or v6). For the HOST's own public IP: Docker DNATs
# hairpin traffic to published ports, which the built-in drop set does not cover.
# Empty = no extra denies — the sandbox then reaches exactly what the internet
# reaches, which is the accepted default.
# SANDBOX_EGRESS_DENY=
# Sandbox container memory ceiling. 2g floor: a measured `npm install` OOMs
# node's default old-space below that (see the node note in sandbox/Dockerfile).
# SANDBOX_MEM_LIMIT=2g

# Detached sandbox runs (`sandbox_bash(detach=true)`): wall-clock ceiling on one
# detached run (seconds) and how many days a finished `.runs/` directory survives
# before the next detached spawn reaps it.
# SANDBOX_DETACH_TIMEOUT_S=14400
# SANDBOX_RUNS_GC_DAYS=7

# The model credential a foreign agent CLI in the sandbox authenticates with. Handed
# to a single run over the SSH channel (as LORE_EXTERNAL_AGENT_KEY) when the call asks
# for it; unset = the external-agent flow is refused rather than silently keyless.
SANDBOX_EXTERNAL_AGENT_KEY=

# ─── ComfyUI image generation (agent-only tool: generate_image) ──────────────
# ComfyUI is an internal service an external MCP client cannot reach, so the
# generate_image tool is served ONLY to the agent (never advertised over MCP).
# Unset COMFYUI_URL = the tool is simply not served. That is a valid deploy.
# COMFYUI_URL=http://comfyui:8188
# Poll-loop deadline (s) for a generation; each HTTP request rides a short
# per-request timeout internally.
# COMFYUI_TIMEOUT_S=120
# Prompt refinement: the refinement LLM model (falls back to CHAT_MODEL)
# and that call's HTTP timeout.
# This is AUTHORITATIVE for refinement — the model selected in the chat is NOT
# used. Point it at a FAST NON-REASONING model: measured on the same payload, a
# reasoning model took 164.1s (≈3900 hidden reasoning tokens for a 170-token
# answer) vs 4.4s for the chat model, and reasoning cannot be turned off from
# here (the router ignores reasoning_effort). Unset = CHAT_MODEL.
# COMFYUI_PROMPT_MODEL=
# Refinement LLM call timeout (s). Pure headroom with a fast refiner; kept at 90
# so a slower model someone points COMFYUI_PROMPT_MODEL at still fits, budgeted
# against TURN_PROGRESS_GRACE_S=300 +
# COMFYUI_TIMEOUT_S=120 (90+120=210 leaves ~90s for the agent's own work).
# COMFYUI_PROMPT_TIMEOUT_S=90
# The refiner prompt (COMFYUI_PROMPT) and the workflow graph (COMFYUI_WORKFLOW,
# ComfyUI "Export (API)" with [lore:prompt|seed|size|batch] in node titles) are
# multiline admin settings; their defaults are backend/configs/comfy_prompt.txt
# and comfy_workflow.json. Edit them in admin, not here.
# Output size per orientation, WIDTHxHEIGHT, filled into the [lore:size] node.
# COMFYUI_SIZE_SQUARE=1024x1024
# COMFYUI_SIZE_PORTRAIT=832x1216
# COMFYUI_SIZE_LANDSCAPE=1216x832
# How many generate_image jobs run at once on the worker. A burst of tool calls
# queues instead of hammering one ComfyUI box.
# COMFY_CONCURRENCY=2

# ─── Web search (the harness serves web_search) ──────────────────────────────
# One provider, chosen in admin settings ("Web search"); these are the env
# defaults an admin override beats. The resolved provider and its key/URL ride
# every turn — a change applies from the next message, no restart. There is no
# off: web_search is always offered, and a provider with an empty key/URL
# fails every search with an explicit error naming it (to stop searching,
# clear the key/URL). deepseek | brave | tavily | searxng; default deepseek.
# WEB_SEARCH_PROVIDER=deepseek
# deepseek: the Anthropic-compatible Messages API at api.deepseek.com — a
# DIFFERENT plane from AI_API_* above, and a paid model call per query.
# DEEPSEEK_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# A SearXNG base URL whose instance has the JSON format enabled.
# SEARXNG_URL=http://searxng:8080

# Host-side published ports for the compose stack. Unset = the fixed
# ports (backend 8001, frontend 5173, Claude Preview 5174) — leave them unset for
# local development. CI sets them to 0 (ephemeral) so several stacks can run
# concurrently on one docker daemon; see the INVARIANT in docker-compose.yml.
# LORE_PORT_BACKEND=8001
# LORE_PORT_FRONTEND=5173
# LORE_PORT_FRONTEND_PREVIEW=5174

# ─── Published images (docker-compose.prod.yml) ─────────────────────────────
# The prod compose pulls prebuilt registry images instead of building — an
# instance stands up from docker-compose.prod.yml + this file alone.
# REQUIRED for the prod compose (no default; ${VAR:?} fails the command).
# LORE_REGISTRY includes the OWNER namespace (Gitea namespaces images by
# owner): host/owner, e.g. registry.example.com/lore — never a bare host.
LORE_REGISTRY=
# REQUIRED for the prod compose. Image tag to pull: pin the immutable vX.Y.Z
# on our prod (rollback = one .env line); partners follow the moving `stable`.
LORE_IMAGE_TAG=
# Host root of the four bind-mounted data dirs (must exist before `up`).
# LORE_DATA_ROOT=/opt/lore/data
# Host port publishing the frontend (nginx) container.
# LORE_HTTP_PORT=5173
