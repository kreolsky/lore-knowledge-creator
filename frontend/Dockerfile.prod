FROM node:22-alpine AS build
WORKDIR /app
COPY package.json .
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# WHY: a template, not conf.d — the stock entrypoint envsubsts it into
# conf.d/default.conf at start, so the CSP frame-src carries this install's
# ARTIFACT_ORIGIN. The filter keeps nginx's own $vars untouched; the empty
# default renders frame-src 'self' (artifacts off).
ENV NGINX_ENVSUBST_FILTER=^ARTIFACT_ORIGIN$
ENV ARTIFACT_ORIGIN=""
COPY nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
