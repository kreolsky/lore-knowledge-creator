# Provider API keys for the bundled router — one per api_key_env named in
# router/config/providers.yaml. Leave out the ones whose provider you deleted.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=

# Optional: require an X-Stat-Key header on /stat/api/* (unset = open).
# STAT_API_KEY=
